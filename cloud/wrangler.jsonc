// Your own mlch server: sharing for your mlch app, on your Cloudflare account.
// Steps in README.md ("Your own server"): `npm run deploy:own` creates the
// storage, makes the server key and deploys. Anyone can open shared links;
// only someone with the key can make new shares.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mlch-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Empty: everything is served from the server's own address. To use your own
  // domains, set both (e.g. https://mlch.example.com and https://share.mlch.example.com) and add routes.
  "vars": { "APEX_ORIGIN": "", "SHARE_ORIGIN": "" },
  // Secret: SERVER_KEY (set by `npm run deploy:own`).
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "mlch-server-shares" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ShareRoom" },
      { "name": "LIMITER", "class_name": "CreateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareRoom", "CreateLimiter"] }],
  "observability": { "enabled": true }
}
