// mlch.app, the hosted server: the landing page, sharing (share.mlch.app),
// accounts and subscriptions. `npm run deploy`. A self-hosted server uses
// wrangler.jsonc instead (README.md, "Your own server").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mlch",
  "account_id": "a7b1e373a9581b6f04e2a48d3abc9aa3",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "mlch.app", "custom_domain": true },
    { "pattern": "www.mlch.app", "custom_domain": true },
    { "pattern": "share.mlch.app", "custom_domain": true }
  ],
  "vars": {
    "APEX_ORIGIN": "https://mlch.app",
    "SHARE_ORIGIN": "https://share.mlch.app",
    // New shares need a signed-in, subscribed account (src/accounts.ts).
    "ACCOUNTS": "on",
    "GOOGLE_CLIENT_ID": "846064973171-sh4vljtpv2f4e5rvrod1pfs2kk3808dd.apps.googleusercontent.com",
    "STRIPE_PRICE": "mlch_sharing_yearly",
    // /admin (src/admin.ts): the Cloudflare Access application "mlch admin" (move38 team, m38.ai addresses).
    "ACCESS_TEAM_DOMAIN": "move38.cloudflareaccess.com",
    "ACCESS_AUD": "d113a5cbd676f2f47b9a9cf7148413f08d8bbe35870bfa02d8953646b874021d"
    // Secrets: GOOGLE_CLIENT_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (wrangler secret put … -c wrangler.mlch.jsonc).
  },
  // Landing page, brand files and the shared-canvas viewer, built by scripts/build.mjs.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "mlch-shares" }],
  "d1_databases": [{ "binding": "DB", "database_name": "mlch-accounts", "database_id": "13dbfdea-44a4-4322-9bc4-97c82bac5c2f", "migrations_dir": "migrations" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ShareRoom" },
      { "name": "LIMITER", "class_name": "CreateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareRoom", "CreateLimiter"] }],
  "observability": { "enabled": true }
}
