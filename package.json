{
  "name": "mlch",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server.js",
    "electron:dev": "electron . --dev",
    "build": "next build",
    "start": "node server.js --production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "electron:test": "node --test electron/tests/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run electron:test",
    "app": "next build && electron .",
    "app:start": "electron .",
    "native": "node scripts/build-native.mjs",
    "dist": "npm run native && MLCH_OFFICIAL=1 node scripts/package-app.mjs && electron-builder --mac",
    "dist:unsigned": "npm run native && node scripts/package-app.mjs && electron-builder --mac dir -c.mac.identity=null -c.appId=app.mlch.mac.dev",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@google/model-viewer": "^4.3.1",
    "@huggingface/transformers": "^4.3.1",
    "@openai/codex": "^0.157.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "postcss": "^8.5.29",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "svg-path-bbox": "^2.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "description": "Voice-first thinking canvas",
  "author": "move38 B.V."
}
