    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "postcss": "^8.5.29",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
